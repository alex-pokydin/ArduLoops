{
  "name": "arduloops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "web": "vite",
    "web:build": "tsc --noEmit && vite build",
    "desktop": "node scripts/with-cargo.mjs tauri dev",
    "build": "node scripts/with-cargo.mjs tauri build",
    "bridge": "node scripts/with-cargo.mjs cargo run --manifest-path src-tauri/Cargo.toml --bin arduloops-bridge --no-default-features",
    "i18n": "node scripts/check-i18n.mjs",
    "cli": "node scripts/arduloops-cli.mjs",
    "preview": "vite preview",
    "tauri": "node scripts/with-cargo.mjs tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
