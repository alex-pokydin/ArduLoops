# ArduLoops copter stand — arm-ready SITL.
# Base: ArduPilot Tools/autotest/default_params/copter.parm
# Overlay: Quad X, lab failsafe/log, GCS_PID_MASK, stock ATC.
# No INS_*_ID / COMPASS_DEV_ID — those are per process.

FRAME_CLASS     1
FRAME_TYPE      1

FS_THR_ENABLE   0
BRD_SAFETY_DEFLT 0
# 0: live Init cannot instantiate a battery driver (needs reboot).
BATT_MONITOR    0
LOG_DISARMED    1
GCS_PID_MASK    7
INITIAL_MODE    0
FENCE_RADIUS    150

INS_GYR_CAL     0
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X  0.001
INS_ACC2OFFS_Y  0.001
INS_ACC2OFFS_Z  0.001
INS_ACC2SCAL_X  1.001
INS_ACC2SCAL_Y  1.001
INS_ACC2SCAL_Z  1.001
INS_ACC3OFFS_X  0
INS_ACC3OFFS_Y  0
INS_ACC3OFFS_Z  0
INS_ACC3SCAL_X  1
INS_ACC3SCAL_Y  1
INS_ACC3SCAL_Z  1

COMPASS_OFS_X   5
COMPASS_OFS_Y   13
COMPASS_OFS_Z   -18
COMPASS_OFS2_X  5
COMPASS_OFS2_Y  13
COMPASS_OFS2_Z  -18
COMPASS_OFS3_X  5
COMPASS_OFS3_Y  13
COMPASS_OFS3_Z  -18
COMPASS_LEARN   0

RC1_MIN         1000
RC1_MAX         2000
RC1_TRIM        1500
RC2_MIN         1000
RC2_MAX         2000
RC2_TRIM        1500
RC3_MIN         1000
RC3_MAX         2000
RC3_TRIM        1500
RC4_MIN         1000
RC4_MAX         2000
RC4_TRIM        1500
RC5_MIN         1000
RC5_MAX         2000
RC5_TRIM        1500
RC6_MIN         1000
RC6_MAX         2000
RC6_TRIM        1500
RC7_MIN         1000
RC7_MAX         2000
RC7_TRIM        1500
RC7_OPTION      7
RC8_MIN         1000
RC8_MAX         2000
RC8_TRIM        1500

FLTMODE1        7
FLTMODE2        9
FLTMODE3        6
FLTMODE4        3
FLTMODE5        5
FLTMODE6        0

MOT_THST_EXPO   0.65
MOT_THST_HOVER  0.39
MOT_BAT_VOLT_MIN 9.6
MOT_BAT_VOLT_MAX 12.8

ATC_RAT_RLL_P   0.135
ATC_RAT_RLL_I   0.135
ATC_RAT_RLL_D   0.0036
ATC_RAT_PIT_P   0.135
ATC_RAT_PIT_I   0.135
ATC_RAT_PIT_D   0.0036
ATC_RAT_YAW_P   0.18
ATC_RAT_YAW_I   0.018
ATC_RAT_YAW_D   0
ATC_ANG_RLL_P   4.5
ATC_ANG_PIT_P   4.5
ATC_ANG_YAW_P   4.5
ATC_INPUT_TC    0.1
ATC_ACC_R_MAX   1100
ATC_ACC_P_MAX   1100
ATC_RATE_R_MAX  0
ATC_RATE_P_MAX  0
