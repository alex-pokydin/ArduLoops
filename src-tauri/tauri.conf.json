{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ArduLoops",
  "identifier": "com.iampm.arduloops",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArduLoops",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCMDM1N0ExQjFBQUEzMApSV1F3cWhvYmVqV3dCQkp2MTRnRVcyeTB5Z0V3YS9xcDI3YjNERitES0xtS0hZWlBtbWo2dW84bQo=",
      "endpoints": [
        "https://github.com/alex-pokydin/ArduLoops/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": ["arduloops"],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
